{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup Python virtual environment",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Setup Python virtual environment (uv)",
            "detail": "Same as above, but with uv (must be on PATH): uv creates .venv for the Python version you enter and can download that interpreter",
            "type": "shell",
            "command": "./setup_venv.sh",
            "windows": {
                "command": ".\\setup_venv.bat"
            },
            "args": [
                "--uv",
                "--python",
                "${input:setupPythonVersion}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Alif: Install M55_HP debug stubs (DevKit-E8, single core configuration)",
            "detail": "Programs the ATOC/MRAM stubs with Alif SETOOLS for the DevKit-E8's device (AE822FA0E5597LS0), so that the Secure Enclave boots the HP core from its MRAM region and J-Link can load and debug it. A boot table built for another part (the AppKit-E8's AE822FA0E5597BS0) is skipped by the Secure Enclave. Set SW4 to SEUART, set 'alif.setools.root' in your VS Code settings.",
            "type": "shell",
            "command": [
                "cp './.alif/M55_HP_mram_cfg_e8.json' '${config:alif.setools.root}/build/config/M55_HP_mram_cfg_e8.json';",
                "cp './.alif/M55_HP_mram_stub.bin' '${config:alif.setools.root}/build/images/M55_HP_mram_stub.bin';",
                "cd '${config:alif.setools.root}';",
                "./tools-config -p 'E8 (AE822FA0E5597LS0) - 5.5 MRAM / 9.75 SRAM';",
                "./app-gen-toc -f 'build/config/M55_HP_mram_cfg_e8.json';",
                "./app-write-mram -p ${input:discoverCOM};"
            ],
            "options": {
                "shell": {
                    "executable": "/bin/bash",
                    "args": [
                        "-c"
                    ]
                }
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "discoverCOM",
            "type": "pickString",
            "description": "Select COM Port for SETOOLS?",
            "options": [
                {
                    "label": "Yes - Enable COM Port Discovery using command option",
                    "value": "-d"
                },
                {
                    "label": "No - COM port is already selected",
                    "value": ""
                }
            ],
            "default": ""
        },
        {
            "id": "setupPythonVersion",
            "type": "promptString",
            "description": "Python version for uv (>=3.10,<3.15), e.g. 3.12 or 3.12.10",
            "default": "3.12"
        }
    ]
}
