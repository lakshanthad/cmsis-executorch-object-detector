# Python (no trailing slash: a .venv that links to a shared venv is ignored too)
.venv
__pycache__/
*.pyc

# The exported ExecuTorch program. detect/make_ai_layer.py writes it next to
# the generated AI layer; the C array in ai_layer_detect/model_pte.c is what
# gets built.
*.pte
# What `yolo export model=yolo26n.pt format=ethos` writes when it runs in the
# repository: the downloaded weights and the export folder.
*.pt
*_ethos_model/

# CMSIS-Toolbox build outputs. The per-context RTE/_<build>_<target>/ folders
# are generated; the layers' RTE/ configuration files are sources.
out/
tmp/
**/RTE/_*/
.cmsis/
*.cbuild-idx.yml
*.cbuild-pack.yml
# The solution's pack lock file is source: it pins the pack versions the
# build was validated with (the layer's RTE config files are from them).
!/cmsis-executorch.cbuild-pack.yml
*.update@*
.cmd.jlink

# Compiler-generated dependencies
*.d
# CMSIS Solution drop-ins are source files, despite the directory suffix.
!.vscode.d/

# Object files
*.o
*.ko
*.obj

# Linker output
*.elf
*.ilk
*.map
*.exp

# Precompiled headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects
*.dll
*.so
*.so.*
*.dylib

# Executables and images
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb
*.dwo

# Regenerated by the CMSIS Solution / clangd extensions on every build, with
# absolute paths for the machine that built it -- so it cannot be committed in
# a portable form. Not committing it loses nothing: it is generated for you.
.clangd

# Editor config. The CMSIS Solution extension regenerates launch.json,
# tasks.json, settings.json and cmsis.json for the active target-type; the
# project's own tasks are in .vscode.d/tasks.json.
.vscode/

# The test image is generated (detect/make_test_image.py) from the bus.jpg of
# the ultralytics package, which is not ours to redistribute.
detect/test_image.c
detect/test_image.h

# macOS Finder metadata
.DS_Store
